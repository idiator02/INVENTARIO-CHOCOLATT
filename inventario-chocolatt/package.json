{
  "name": "inventario-chocolatt",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-sw.mjs dist",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:demo": "vite --mode demo",
    "build:demo": "vite build --mode demo --outDir dist-demo && node scripts/generate-sw.mjs dist-demo",
    "preview:demo": "vite preview --outDir dist-demo",
    "test": "node --test tests/*.test.js",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
